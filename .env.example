# Apple Music API Configuration
# Copy this file to .env and fill in your actual credentials

# Your Apple Developer Team ID (10-character string)
# Find this at: https://developer.apple.com/account (top-right corner)
APPLE_MUSIC_TEAM_ID=ABC123XYZ9

# Your MusicKit Key ID (10-character string)
# Get this when you create a MusicKit key at:
# https://developer.apple.com/account/resources/authkeys/list
APPLE_MUSIC_KEY_ID=XYZ9876ABC

# Path to your MusicKit private key (.p8 file)
# Download this when you create your MusicKit key (can only download once!)
# Place the .p8 file in the project root or specify full path
APPLE_MUSIC_PRIVATE_KEY_FILE=./AuthKey_XYZ9876ABC.p8

# Alternative: You can paste the private key content directly (PEM format)
# Uncomment and use this instead of APPLE_MUSIC_PRIVATE_KEY_FILE if preferred
# APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
# MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...
# -----END PRIVATE KEY-----
